#!/usr/bin/env python
"""Offline self-check for the Llama-4 axolotl image.

Run with networking disabled:
  docker run --rm --gpus all --network none <image> llama4-offline-check
Exit code 0 = every required check passed.
"""
import importlib
import importlib.metadata as md
import os
import socket
import subprocess
import sys
import traceback

RESULTS = []


def check(name, required=True):
    def deco(fn):
        try:
            detail = fn() or ""
            RESULTS.append((name, "PASS", detail, required))
        except Exception as exc:  # noqa: BLE001
            status = "FAIL" if required else "WARN"
            RESULTS.append((name, status, f"{type(exc).__name__}: {exc}", required))
            if os.environ.get("CHECK_VERBOSE"):
                traceback.print_exc()
        return fn
    return deco


@check("network is really off (informational)", required=False)
def _net():
    try:
        socket.create_connection(("huggingface.co", 443), timeout=3).close()
    except OSError:
        return "no outbound connectivity (good)"
    raise RuntimeError("outbound network reachable -- run with --network none for a real test")


@check("offline env vars")
def _env():
    need = {"HF_HUB_OFFLINE": "1", "TRANSFORMERS_OFFLINE": "1", "HF_DATASETS_OFFLINE": "1",
            "AXOLOTL_DO_NOT_TRACK": "1", "DO_NOT_TRACK": "1"}
    bad = {k: os.environ.get(k) for k, v in need.items() if os.environ.get(k) != v}
    assert not bad, bad
    return "ok"


@check("versions")
def _versions():
    import torch
    want_tf = os.environ.get("LLAMA4_EXPECT_TRANSFORMERS", "4.57.6")
    tf = md.version("transformers")
    assert tf == want_tf, f"transformers {tf} != {want_tf}"
    pk = {p: md.version(p) for p in ("axolotl", "accelerate", "peft", "trl", "bitsandbytes",
                                     "liger-kernel", "torchao", "deepspeed", "cut-cross-entropy")}
    return f"torch {torch.__version__} cuda {torch.version.cuda} | transformers {tf} | " + \
        ", ".join(f"{k} {v}" for k, v in pk.items())


