# syntax=docker/dockerfile:1
# Gemma-4 training image. Layers experiment tracking and the optional plugin
# dependencies on top of the base axolotl image, which already carries everything
# the Gemma-4 critical path needs (CCE fork with native gemma4 patches, in-tree
# ScatterMoE, triton, bitsandbytes, torchao).
ARG BASE_TAG=main
FROM axolotlai/axolotl-uv:$BASE_TAG

# Experiment tracking. wandb, tensorboard and trackio are already core deps; these
# are the two that are not. mlflow-skinny is the client half of the `mlflow` extra --
# it drops the tracking server and its data-science stack (Flask, sqlalchemy,
# alembic, gunicorn, pandas, pyarrow, scikit-learn, matplotlib), which a training
# container that logs to a remote server never uses. Swap in `mlflow` if you want to
# run `mlflow ui` inside this image.
ARG MLFLOW_VERSION="3.15.1"
ARG SWANLAB_VERSION="0.9.2"

# Optional plugin deps. densemixer is the alternative MoE routing path for 26B-A4B,
# orjson is used by the KD plugin, math-verify by the GRPO math rewards.
ARG DENSEMIXER_VERSION="1.0.1"
ARG ORJSON_VERSION="3.11.9"
ARG MATH_VERIFY_VERSION="0.9.0"

# Gemma-4 checkpoints are large (26B/31B). HF_HUB_ENABLE_HF_TRANSFER is deprecated on
# huggingface_hub 1.x -- Xet superseded hf_transfer. Matches Dockerfile-cloud-uv.
ENV HF_XET_HIGH_PERFORMANCE=1

# Opt out of axolotl's telemetry (telemetry/manager.py accepts "1" or "true").
ENV AXOLOTL_DO_NOT_TRACK=1

# Deliberately NOT installed:
#   llmcompressor - pins transformers<=5.10.1, which would downgrade the pinned
#                   5.14.1 and take native flash_attention_4 dispatch with it
#   hatchery      - the PyPI package of that name is an unrelated CD helper; the
#                   `hatchery.core.client` the plugin imports is not published
#   deep_gemm     - sdist only, provenance unverified (gates the FP8 MoE backward)
#   sf_layout     - not published on PyPI at all (gates part of the FP4 CuTe path)
# (`deep-ep` on PyPI is a name placeholder with no author, homepage or deps -- the
#  real library is built from source below.)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install \
        "mlflow-skinny==${MLFLOW_VERSION}" \
        "swanlab==${SWANLAB_VERSION}" \
        "densemixer==${DENSEMIXER_VERSION}" \
        "orjson==${ORJSON_VERSION}" \
        "math-verify==${MATH_VERIFY_VERSION}"

# DeepEP, for the expert_parallel plugin. Built from source following the recipe in
# src/axolotl/integrations/expert_parallel/README.md.
#
# The v1.2.1 pin is required, not cosmetic: it is the last release whose setup.py
# still carries the `disable_nvshmem` path the patches below edit (DeepEP #664
# restructured it on main), and it avoids main's csrc/elastic/, which needs
# ncclGinRequest_t from NCCL 2.29+ -- torch 2.11.0 pins nvidia-nccl-cu13==2.28.9.
#
# DISABLE_NVSHMEM=1 builds intranode (NVLink) dispatch/combine only, skipping the
# NVSHMEM path that would otherwise need Mellanox OFED dev headers. Multi-node EP
# over RDMA is therefore NOT available in this image.
#
# ARCH NOTE: DeepEP v1.2.1 documents Ampere (sm_80) and Hopper (sm_90) support only;
# sm_100 is untested upstream, so the 10.0 target below may fail to compile or yield
# kernels that never run. Additionally, v1.2.1's setup.py asserts
# DISABLE_AGGRESSIVE_PTX_INSTRS==1 whenever TORCH_CUDA_ARCH_LIST is not exactly "9.0":
# the aggressive .L1::no_allocate LD/ST path is already off by default, but a non-"9.0"
# list forecloses ever opting into it. Set this to "9.0" for the recipe the integration
# README actually tests.
ARG DEEPEP_REF="v1.2.1"
ARG DEEPEP_TORCH_CUDA_ARCH_LIST="9.0;10.0"
ARG DEEPEP_MAX_JOBS="16"

RUN --mount=type=cache,target=/root/.cache/uv <<'SHELL'
set -eux
git clone --depth 1 --branch "${DEEPEP_REF}" https://github.com/deepseek-ai/DeepEP.git /tmp/DeepEP
cd /tmp/DeepEP

# Patch 1: honor DISABLE_NVSHMEM=1
git apply <<'PATCH'
--- a/setup.py
+++ b/setup.py
@@ -19,7 +19,10 @@ if __name__ == '__main__':
     disable_nvshmem = False
     nvshmem_dir = os.getenv('NVSHMEM_DIR', None)
     nvshmem_host_lib = 'libnvshmem_host.so'
-    if nvshmem_dir is None:
+    if int(os.getenv('DISABLE_NVSHMEM', '0')):
+        disable_nvshmem = True
+        nvshmem_dir = None
+    elif nvshmem_dir is None:
         try:
             nvshmem_dir = importlib.util.find_spec("nvidia.nvshmem").submodule_search_locations[0]
             nvshmem_host_lib = get_nvshmem_host_lib_name(nvshmem_dir)
PATCH

# Patch 2: drop -rdc=true when NVSHMEM is off, or the device-link step leaves
# __cudaRegisterLinkedBinary_* undefined and the import fails
git apply <<'PATCH'
--- a/setup.py
+++ b/setup.py
@@ -71,7 +71,9 @@ if __name__ == '__main__':
         os.environ['TORCH_CUDA_ARCH_LIST'] = os.getenv('TORCH_CUDA_ARCH_LIST', '9.0')

         # CUDA 12 flags
-        nvcc_flags.extend(['-rdc=true', '--ptxas-options=--register-usage-level=10'])
+        nvcc_flags.append('--ptxas-options=--register-usage-level=10')
+        if not disable_nvshmem:
+            nvcc_flags.append('-rdc=true')

     # Disable LD/ST tricks, as some CUDA version does not support `.L1::no_allocate`
     if os.environ['TORCH_CUDA_ARCH_LIST'].strip() != '9.0':
PATCH

DISABLE_NVSHMEM=1 \
TORCH_CUDA_ARCH_LIST="${DEEPEP_TORCH_CUDA_ARCH_LIST}" \
MAX_JOBS="${DEEPEP_MAX_JOBS}" \
  uv pip install --no-build-isolation .

cd / && rm -rf /tmp/DeepEP
SHELL

# Fail the build rather than a training run if any of the above moved the pinned
# HF/torch stack, and confirm the Gemma-4 pieces the examples depend on are wired
# up. Kept CUDA-free so it runs on a GPU-less builder.
RUN python -c "\
import importlib.metadata as md, importlib.util, torch; \
assert torch.__version__.startswith('2.11.'), 'torch moved: ' + torch.__version__; \
assert md.version('transformers') == '5.14.1', 'transformers moved: ' + md.version('transformers'); \
from cut_cross_entropy.transformers.patch import AXOLOTL_CCE_FORK, PATCH_FNS; \
assert AXOLOTL_CCE_FORK, 'CCE is not the axolotl fork'; \
missing = [k for k in ('gemma4', 'gemma4_text', 'gemma4_unified', 'gemma4_unified_text') if k not in PATCH_FNS]; \
assert not missing, 'CCE lacks native gemma4 patches: ' + repr(missing); \
absent = [m for m in ('densemixer', 'mlflow', 'swanlab', 'orjson', 'math_verify', 'triton', 'bitsandbytes') if importlib.util.find_spec(m) is None]; \
assert not absent, 'missing modules: ' + repr(absent); \
assert md.version('deep_ep').startswith('1.2.1'), 'unexpected deep_ep: ' + md.version('deep_ep'); \
import deep_ep; \
assert deep_ep.Buffer is not None; \
print('ok: torch', torch.__version__, '| transformers', md.version('transformers'), '| deep_ep', md.version('deep_ep'), '| CCE gemma4 patches present')"
