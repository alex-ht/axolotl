# syntax=docker/dockerfile:1
# Gemma-4 training image. Layers experiment tracking and the optional plugin
# dependencies on top of the base axolotl image, which already carries everything
# the Gemma-4 critical path needs (CCE fork with native gemma4 patches, in-tree
# ScatterMoE, triton, bitsandbytes, torchao).
ARG BASE_TAG=main
FROM axolotlai/axolotl-uv:$BASE_TAG

# Experiment tracking. wandb, tensorboard and trackio are already core deps; these
# are the two that are not. mlflow-skinny is the client half of the `mlflow` extra --
# it drops the tracking server and its data-science stack (Flask, sqlalchemy,
# alembic, gunicorn, pandas, pyarrow, scikit-learn, matplotlib), which a training
# container that logs to a remote server never uses. Swap in `mlflow` if you want to
# run `mlflow ui` inside this image.
ARG MLFLOW_VERSION="3.15.1"
ARG SWANLAB_VERSION="0.9.2"

# Optional plugin deps. densemixer is the alternative MoE routing path for 26B-A4B,
# orjson is used by the KD plugin, math-verify by the GRPO math rewards.
ARG DENSEMIXER_VERSION="1.0.1"
ARG ORJSON_VERSION="3.11.9"
ARG MATH_VERIFY_VERSION="0.9.0"

# Gemma-4 checkpoints are large (26B/31B); hf_transfer is already installed.
ENV HF_HUB_ENABLE_HF_TRANSFER=1

# Opt out of axolotl's telemetry (telemetry/manager.py accepts "1" or "true").
ENV AXOLOTL_DO_NOT_TRACK=1

# Deliberately NOT installed:
#   llmcompressor - pins transformers<=5.10.1, which would downgrade the pinned
#                   5.14.1 and take native flash_attention_4 dispatch with it
#   hatchery      - the PyPI package of that name is an unrelated CD helper; the
#                   `hatchery.core.client` the plugin imports is not published
#   deep_ep       - source build only
#   deep_gemm     - sdist only, provenance unverified (gates the FP8 MoE backward)
#   sf_layout     - not published on PyPI at all (gates part of the FP4 CuTe path)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install \
        "mlflow-skinny==${MLFLOW_VERSION}" \
        "swanlab==${SWANLAB_VERSION}" \
        "densemixer==${DENSEMIXER_VERSION}" \
        "orjson==${ORJSON_VERSION}" \
        "math-verify==${MATH_VERIFY_VERSION}"

# Fail the build rather than a training run if any of the above moved the pinned
# HF/torch stack, and confirm the Gemma-4 pieces the examples depend on are wired
# up. Kept CUDA-free so it runs on a GPU-less builder.
RUN python -c "\
import importlib.metadata as md, importlib.util, torch; \
assert torch.__version__.startswith('2.11.'), 'torch moved: ' + torch.__version__; \
assert md.version('transformers') == '5.14.1', 'transformers moved: ' + md.version('transformers'); \
from cut_cross_entropy.transformers.patch import AXOLOTL_CCE_FORK, PATCH_FNS; \
assert AXOLOTL_CCE_FORK, 'CCE is not the axolotl fork'; \
missing = [k for k in ('gemma4', 'gemma4_text', 'gemma4_unified', 'gemma4_unified_text') if k not in PATCH_FNS]; \
assert not missing, 'CCE lacks native gemma4 patches: ' + repr(missing); \
absent = [m for m in ('densemixer', 'mlflow', 'swanlab', 'orjson', 'math_verify', 'triton', 'bitsandbytes') if importlib.util.find_spec(m) is None]; \
assert not absent, 'missing modules: ' + repr(absent); \
print('ok: torch', torch.__version__, '| transformers', md.version('transformers'), '| CCE gemma4 patches present')"
