# syntax=docker/dockerfile:1
# Self-contained AFS training image (Gemma-4, Mamba/SSM, and other models),
# built in one step from the CUDA/torch base.
#
# This duplicates Dockerfile-uv's axolotl install rather than layering on the
# axolotl-uv image, so only one base has to be published. The two install blocks
# must be kept in sync -- if you change Dockerfile-uv's extras, CCE step or vLLM/FA4
# pins, mirror it here.
# Upstream base (CUDA 13.0.3, py3.12, torch 2.13.0 cu130), same tag upstream CI
# uses (cicd/single_gpu.py, cicd/multigpu.py). torch 2.13.0 rather than 2.14.1
# because vLLM 0.30.0 pins torch==2.13.0. `main-base-*` tags move; for a
# reproducible build pass BASE_TAG=main-base-py3.12-cu130-2.13.0@sha256:<digest>
# (2026-10-25 manifest list: sha256:2a065dc4cef475d664ecace421e4909207e753186f5fe968e1cfc57b0443af87).
ARG BASE_IMAGE=axolotlai/axolotl-base-uv
ARG BASE_TAG=main-base-py3.12-cu130-2.13.0
FROM $BASE_IMAGE:$BASE_TAG

ARG TORCH_CUDA_ARCH_LIST="9.0 10.0 12.0+PTX"
ARG AXOLOTL_EXTRAS=""
ARG AXOLOTL_ARGS=""
ARG CUDA="130"
ARG PYTORCH_VERSION="2.13.0"
ARG TORCH_BACKEND="cu130"
# vLLM 0.30.0 is the newest release that accepts transformers 5.20.1 (0.31.0 pins
# transformers<5.18.0, 0.32.0 <5.20.0). It pins torch==2.13.0,
# nvidia-cutlass-dsl[cu13]==4.7.1 and quack-kernels==0.6.5.
ARG VLLM_VERSION="0.30.0"
# Same FA4 as the v0.21.1 `blackwell` extra; needs cutlass-dsl>=4.6.2, quack>=0.5.3.
ARG FLASH_ATTN_4_VERSION="4.0.0b35"
ARG CUTLASS_DSL_VERSION="4.7.1"
ARG QUACK_VERSION="0.6.5"
ARG TARGETARCH

ENV PYTORCH_VERSION=$PYTORCH_VERSION
# Hardlinks from a uv cache mount into the image layer break on overlayfs.
ENV UV_LINK_MODE=copy

WORKDIR /workspace/axolotl

COPY . .

# Drop the base image's causal_conv1d (SKIP_CUDA_BUILD / often ABI-mismatched).
# A real CUDA build is installed in the next layer.
# BNB_SKIP_CMAKE: pyproject pulls bitsandbytes from git; skip the CUDA ext here
# and compile it in a dedicated layer below (cmake is not in the base image).
# --no-build-isolation does not install PEP 517 build-system requires, so
# scikit-build-core (bitsandbytes backend) must already be in the venv.
# If AXOLOTL_EXTRAS is set, append it in brackets; don't install deepspeed on arm64.
RUN uv pip uninstall causal_conv1d
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install "huggingface_hub>=1.5.0" "httpx<1" "kernels-data" \
        scikit-build-core "setuptools>=77.0.3" "trove-classifiers>=2025.8.6.13" && \
    if [ "$TARGETARCH" = "arm64" ]; then \
        BASE_EXTRAS="optimizers,ray,ringmaster,modelopt"; \
    else \
        BASE_EXTRAS="deepspeed,optimizers,ray,fla,ringmaster,modelopt"; \
    fi && \
    TORCH_PIN="torch==$(python -c 'import torch; print(torch.__version__)')" && \
    if [ "$AXOLOTL_EXTRAS" != "" ]; then \
        BNB_SKIP_CMAKE=TRUE uv pip install --no-build-isolation -e .[$BASE_EXTRAS,$AXOLOTL_EXTRAS] "$TORCH_PIN" $AXOLOTL_ARGS; \
    else \
        BNB_SKIP_CMAKE=TRUE uv pip install --no-build-isolation -e .[$BASE_EXTRAS] "$TORCH_PIN" $AXOLOTL_ARGS; \
    fi && \
    python scripts/cutcrossentropy_install.py --uv | sh && \
    uv pip install pytest

# PyPI sdists omit csrc/. Clone full trees and FORCE_BUILD against the
# venv torch. The alex-ht fork defaults to no CUDA ext; KEEP_CUDA_BUILD
# is required to compile selective_scan_cuda.
# --no-config: skip pyproject extra-build-dependencies match-runtime.
ARG CAUSAL_CONV1D_REF="v1.5.3.post1"
ARG MAMBA_MAX_JOBS="16"

RUN --mount=type=cache,target=/root/.cache/uv <<'SHELL'
set -eux
if [ "${TARGETARCH}" = "arm64" ]; then
  exit 0
fi

git clone --depth 1 --branch "${CAUSAL_CONV1D_REF}" \
    https://github.com/Dao-AILab/causal-conv1d.git /tmp/causal-conv1d
cd /tmp/causal-conv1d
CAUSAL_CONV1D_FORCE_BUILD=TRUE MAX_JOBS="${MAMBA_MAX_JOBS}" \
  uv pip install --no-build-isolation --no-config .
cd / && rm -rf /tmp/causal-conv1d

git clone --depth 1 --branch afs \
    https://github.com/alex-ht/mamba.git /tmp/mamba
cd /tmp/mamba
MAMBA_FORCE_BUILD=TRUE MAMBA_KEEP_CUDA_BUILD=TRUE MAX_JOBS="${MAMBA_MAX_JOBS}" \
  uv pip install --no-build-isolation --no-config .
cd / && rm -rf /tmp/mamba
SHELL

# bitsandbytes CUDA kernels from alex-ht/fix/issue-1785 (#1785 int64 indexing, not in
# upstream 0.50.2). The axolotl install layer used BNB_SKIP_CMAKE so this is the real
# GPU build. Pinned to the branch head commit for reproducibility.
ARG BNB_REF="d8860cd35e1efdd161b8dc3b4ee58dd3cfa253df"
ARG BNB_MAX_JOBS="16"

RUN --mount=type=cache,target=/root/.cache/uv <<'SHELL'
set -eux
if [ "${TARGETARCH}" = "arm64" ]; then
  exit 0
fi

uv pip install scikit-build-core cmake ninja
git init /tmp/bitsandbytes
cd /tmp/bitsandbytes
git remote add origin https://github.com/alex-ht/bitsandbytes.git
git fetch --depth 1 origin "${BNB_REF}"
git checkout FETCH_HEAD
CMAKE_ARGS="-DCOMPUTE_BACKEND=cuda" \
TORCH_CUDA_ARCH_LIST="${TORCH_CUDA_ARCH_LIST}" \
MAX_JOBS="${BNB_MAX_JOBS}" \
  uv pip install --no-build-isolation --no-config --no-deps --reinstall .
cd / && rm -rf /tmp/bitsandbytes
SHELL

# vLLM and FA4 resolved together so their shared nvidia-cutlass-dsl pin is reconciled in
# one pass. FA4 is a pure-Python wheel (CuTe DSL, JIT at runtime), so nothing compiles here
# and FA2 is deliberately absent -- it is sdist-only and has no prebuilt wheel for torch 2.13.
# xformers 0.0.35 is the latest release (requires torch>=2.10, no exact pin).
# torch is pinned to the base build so vLLM cannot swap it.
RUN --mount=type=cache,target=/root/.cache/uv \
    UV_TORCH_BACKEND=$TORCH_BACKEND uv pip install --prerelease=allow \
        "torch==${PYTORCH_VERSION}" \
        "vllm==${VLLM_VERSION}" \
        "flash-attn-4[cu13]==${FLASH_ATTN_4_VERSION}" \
        "nvidia-cutlass-dsl[cu13]==${CUTLASS_DSL_VERSION}" \
        "quack-kernels[cu13]==${QUACK_VERSION}" \
        "xformers==0.0.35"

# fix so that git fetch/pull from remote works with shallow clone
RUN git config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*" && \
    git config --get remote.origin.fetch && \
    git config --global credential.helper store

COPY .axolotl-complete.bash /root/.axolotl-complete.bash
RUN chmod +x /root/.axolotl-complete.bash && \
    chmod +x /workspace/axolotl/scripts/uv-entrypoint.sh && \
    echo 'source /root/.axolotl-complete.bash' >> ~/.bashrc

# Experiment tracking. wandb, tensorboard and trackio are already core deps; these
# are the two that are not. mlflow-skinny is the client half of the `mlflow` extra --
# it drops the tracking server and its data-science stack (Flask, sqlalchemy,
# alembic, gunicorn, pandas, pyarrow, scikit-learn, matplotlib), which a training
# container that logs to a remote server never uses. Swap in `mlflow` if you want to
# run `mlflow ui` inside this image.
ARG MLFLOW_VERSION="3.15.1"
ARG SWANLAB_VERSION="0.9.2"

# Optional plugin deps. densemixer is the alternative MoE routing path for 26B-A4B,
# orjson is used by the KD plugin, math-verify by the GRPO math rewards.
ARG DENSEMIXER_VERSION="1.0.1"
ARG ORJSON_VERSION="3.11.9"
ARG MATH_VERIFY_VERSION="0.9.0"

# Large checkpoints (Gemma-4 26B/31B, Nemotron-H, …). HF_HUB_ENABLE_HF_TRANSFER is
# deprecated on huggingface_hub 1.x -- Xet superseded hf_transfer. Matches
# Dockerfile-cloud-uv.
ENV HF_XET_HIGH_PERFORMANCE=1

# Opt out of axolotl's telemetry (telemetry/manager.py accepts "1" or "true").
ENV AXOLOTL_DO_NOT_TRACK=1

# Deliberately NOT installed:
#   llmcompressor - pins transformers<=5.10.1, which would downgrade the pinned
#                   5.20.1 and take native flash_attention_4 dispatch with it
#   hatchery      - the PyPI package of that name is an unrelated CD helper; the
#                   `hatchery.core.client` the plugin imports is not published
#   sf_layout     - not published on PyPI at all (gates part of the FP4 CuTe path)
# (`deep-ep` on PyPI is a name placeholder with no author, homepage or deps -- the
#  real library is built from source below.)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install \
        "mlflow-skinny==${MLFLOW_VERSION}" \
        "swanlab==${SWANLAB_VERSION}" \
        "densemixer==${DENSEMIXER_VERSION}" \
        "orjson==${ORJSON_VERSION}" \
        "math-verify==${MATH_VERIFY_VERSION}"

# DeepEP, for the expert_parallel plugin. Built from source. V2 switched from
# NVSHMEM to NCCL Gin, so no NVSHMEM dependency is needed for intranode builds.
# ARCH NOTE: sm_100 is untested upstream. setup.py asserts
# DISABLE_AGGRESSIVE_PTX_INSTRS==1 whenever TORCH_CUDA_ARCH_LIST is not exactly "9.0".
ARG DEEPEP_REF="fix/large-model-int-overflow"
ARG DEEPEP_TORCH_CUDA_ARCH_LIST="9.0;10.0"
ARG DEEPEP_MAX_JOBS="16"
# DeepEP V2 GIN needs NCCL >= 2.30.4 (ncclCommQueryProperties). torch 2.13.0 pins
# nvidia-nccl-cu13==2.29.7; later uv installs can restore that pin.
ARG NCCL_VERSION="2.30.4"

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --no-deps --reinstall "nvidia-nccl-cu13==${NCCL_VERSION}"

RUN --mount=type=cache,target=/root/.cache/uv <<'SHELL'
set -eux
git clone --depth 1 --branch "${DEEPEP_REF}" https://github.com/alex-ht/DeepEP.git /tmp/DeepEP
cd /tmp/DeepEP

TORCH_CUDA_ARCH_LIST="${DEEPEP_TORCH_CUDA_ARCH_LIST}" \
MAX_JOBS="${DEEPEP_MAX_JOBS}" \
  uv pip install --no-build-isolation .

cd / && rm -rf /tmp/DeepEP
SHELL

# sonic-moe is CuTe-DSL (JIT on first GPU use); no CUDA ext at image build.
# Clone GitHub: PyPI 0.1.2.post1 still pins torch<=2.9.1 and cutlass-dsl==4.4.2.
# vLLM 0.30.0 now requires quack-kernels==0.6.5 / cutlass-dsl 4.7.1, so move to main
# HEAD 7396f3e (2026-08-17: requires quack-kernels>=0.6.4, adds non-gated activations
# via unified QuACK APIs, keeps moe_general_routing_inputs + enums.ActivationType).
# --no-deps on sonic-moe; quack / cutlass-dsl stay on the vLLM pins.
ARG SONICMOE_REF="7396f3e604827d8186c2e16e64b28ee33d3defd0"

RUN --mount=type=cache,target=/root/.cache/uv <<'SHELL'
set -eux
if [ "${TARGETARCH}" = "arm64" ]; then
  exit 0
fi

git init /tmp/sonic-moe
cd /tmp/sonic-moe
git remote add origin https://github.com/Dao-AILab/sonic-moe.git
git fetch --depth 1 origin "${SONICMOE_REF}"
git checkout FETCH_HEAD
uv pip install --no-deps .
uv pip install \
    "quack-kernels[cu13]==${QUACK_VERSION}" \
    "nvidia-cutlass-dsl[cu13]==${CUTLASS_DSL_VERSION}" \
    "apache-tvm-ffi>=0.1.11,<0.2"
cd / && rm -rf /tmp/sonic-moe
SHELL

# DeepGEMM, for ScatterMoE NVFP4 grouped GEMM (and optional sonicmoe fp8 backward).
# JIT at first GPU use; no CUDA ext at image build. Clone GitHub: PyPI sdist is
# unverified, and runtime get_kernel("kernels-community/deep-gemm") hits the Hub.
ARG DEEPGEMM_REF="559d79fb6994a58b8a15b4b93bf13ccc16edf247"

RUN --mount=type=cache,target=/root/.cache/uv <<'SHELL'
set -eux
if [ "${TARGETARCH}" = "arm64" ]; then
  exit 0
fi

git init /tmp/DeepGEMM
cd /tmp/DeepGEMM
git remote add origin https://github.com/deepseek-ai/DeepGEMM.git
git fetch --depth 1 origin "${DEEPGEMM_REF}"
git checkout FETCH_HEAD
git submodule update --init --recursive --depth 1
uv pip install --no-build-isolation .
cd / && rm -rf /tmp/DeepGEMM
SHELL

# DeepGEMM / torch resolvers can put nvidia-nccl-cu13 back on 2.28.9. Restore
# the GIN-capable lib so `import deep_ep` does not hit undefined symbols.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --no-deps --reinstall "nvidia-nccl-cu13==${NCCL_VERSION}"

# Fail the build rather than a training run if any of the above moved the pinned
# HF/torch stack, and confirm Gemma-4 CCE patches plus mamba-ssm are
# wired up. find_spec only -- importing mamba_ssm/causal_conv1d loads CUDA
# extensions and would fail on a GPU-less builder.
RUN python -c "\
import importlib.metadata as md, importlib.util, torch; \
assert torch.__version__.startswith('2.13.0'), 'torch moved: ' + torch.__version__; \
assert md.version('transformers') == '5.20.1', 'transformers moved: ' + md.version('transformers'); \
assert md.version('vllm') == '0.30.0', 'vllm moved: ' + md.version('vllm'); \
from ringmaster.strategies.ulysses import SUPPORTS_FLEX_BLOCK_MASK; \
assert SUPPORTS_FLEX_BLOCK_MASK, 'ringmaster lacks Ulysses flex BlockMask'; \
fa = [x.replace('_', '-') for x in md.packages_distributions().get('flash_attn', [])]; \
assert 'flash-attn-4' in fa, 'FA4 not registered: ' + repr(fa); \
assert 'flash-attn' not in fa, 'FA2 present, will shadow FA4: ' + repr(fa); \
from cut_cross_entropy.transformers.patch import AXOLOTL_CCE_FORK, PATCH_FNS; \
assert AXOLOTL_CCE_FORK, 'CCE is not the axolotl fork'; \
missing = [k for k in ('gemma4', 'gemma4_text', 'gemma4_unified', 'gemma4_unified_text') if k not in PATCH_FNS]; \
assert not missing, 'CCE lacks native gemma4 patches: ' + repr(missing); \
absent = [m for m in ('densemixer', 'mlflow', 'swanlab', 'orjson', 'math_verify', 'triton', 'bitsandbytes', 'mamba_ssm', 'causal_conv1d', 'sonicmoe', 'deep_gemm', 'fla', 'ringmaster') if importlib.util.find_spec(m) is None]; \
assert not absent, 'missing modules: ' + repr(absent); \
assert md.version('bitsandbytes').startswith('0.50.2'), 'unexpected bitsandbytes: ' + md.version('bitsandbytes'); \
assert md.version('mamba_ssm').startswith('2.3.2'), 'unexpected mamba-ssm: ' + md.version('mamba_ssm'); \
assert md.version('causal_conv1d').startswith('1.5.3'), 'unexpected causal-conv1d: ' + md.version('causal_conv1d'); \
assert md.version('deep_ep').startswith('2.1.0'), 'unexpected deep_ep: ' + md.version('deep_ep'); \
assert md.version('sonic-moe').startswith('0.1.2'), 'unexpected sonic-moe: ' + md.version('sonic-moe'); \
assert md.version('quack-kernels') == '0.6.5', 'unexpected quack-kernels: ' + md.version('quack-kernels'); \
assert md.version('nvidia-cutlass-dsl') == '4.7.1', 'cutlass-dsl moved: ' + md.version('nvidia-cutlass-dsl'); \
assert tuple(int(x) for x in md.version('nvidia-nccl-cu13').split('.')[:3]) >= (2, 30, 4), 'nccl too old for DeepEP GIN: ' + md.version('nvidia-nccl-cu13'); \
import deep_ep; \
assert deep_ep.Buffer is not None; \
print('ok: torch', torch.__version__, '| transformers', md.version('transformers'), '| vllm', md.version('vllm'), '| deep_ep', md.version('deep_ep'), '| mamba-ssm', md.version('mamba_ssm'), '| flash_attn owned by', fa, '| CCE gemma4 patches present')"

ENTRYPOINT ["/workspace/axolotl/scripts/uv-entrypoint.sh"]
