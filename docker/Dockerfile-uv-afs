# syntax=docker/dockerfile:1
# Self-contained AFS training image (Gemma-4, Mamba/SSM, and other models),
# built in one step from the CUDA/torch base.
#
# This duplicates Dockerfile-uv's axolotl install rather than layering on the
# axolotl-uv image, so only one base has to be published. The two install blocks
# must be kept in sync -- if you change Dockerfile-uv's extras, CCE step or vLLM/FA4
# pins, mirror it here.
ARG BASE_IMAGE=alexht/axolotl-base-uv
ARG BASE_TAG=20260804
FROM $BASE_IMAGE:$BASE_TAG

ARG TORCH_CUDA_ARCH_LIST="9.0 10.0 12.0+PTX"
ARG AXOLOTL_EXTRAS=""
ARG AXOLOTL_ARGS=""
ARG CUDA="130"
ARG PYTORCH_VERSION="2.11.0"
ARG TORCH_BACKEND="cu130"
ARG VLLM_VERSION="0.26.0"
# b20+ hard-pin nvidia-cutlass-dsl==4.6.0.dev0, which collides with vllm's ==4.6.0
ARG FLASH_ATTN_4_VERSION="4.0.0b19"
ARG TARGETARCH

ENV PYTORCH_VERSION=$PYTORCH_VERSION
# Hardlinks from a uv cache mount into the image layer break on overlayfs.
ENV UV_LINK_MODE=copy

WORKDIR /workspace/axolotl

COPY . .

# Drop the base image's causal_conv1d (SKIP_CUDA_BUILD / often ABI-mismatched).
# A real CUDA build is installed in the next layer.
# If AXOLOTL_EXTRAS is set, append it in brackets; don't install deepspeed on arm64.
RUN uv pip uninstall causal_conv1d
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install "huggingface_hub>=1.5.0" "httpx<1" "kernels-data" && \
    if [ "$TARGETARCH" = "arm64" ]; then \
        BASE_EXTRAS="optimizers,ray,modelopt"; \
    else \
        BASE_EXTRAS="deepspeed,optimizers,ray,modelopt"; \
    fi && \
    if [ "$AXOLOTL_EXTRAS" != "" ]; then \
        uv pip install --no-build-isolation -e .[$BASE_EXTRAS,$AXOLOTL_EXTRAS] $AXOLOTL_ARGS; \
    else \
        uv pip install --no-build-isolation -e .[$BASE_EXTRAS] $AXOLOTL_ARGS; \
    fi && \
    python scripts/cutcrossentropy_install.py --uv | sh && \
    uv pip install pytest

# PyPI sdists omit csrc/. Clone full trees and FORCE_BUILD against the
# venv torch. The alex-ht fork defaults to no CUDA ext; KEEP_CUDA_BUILD
# is required to compile selective_scan_cuda.
# --no-config: skip pyproject extra-build-dependencies match-runtime.
ARG CAUSAL_CONV1D_REF="v1.5.3.post1"
ARG MAMBA_MAX_JOBS="16"

RUN --mount=type=cache,target=/root/.cache/uv <<'SHELL'
set -eux
if [ "${TARGETARCH}" = "arm64" ]; then
  exit 0
fi

git clone --depth 1 --branch "${CAUSAL_CONV1D_REF}" \
    https://github.com/Dao-AILab/causal-conv1d.git /tmp/causal-conv1d
cd /tmp/causal-conv1d
CAUSAL_CONV1D_FORCE_BUILD=TRUE MAX_JOBS="${MAMBA_MAX_JOBS}" \
  uv pip install --no-build-isolation --no-config .
cd / && rm -rf /tmp/causal-conv1d

git clone --depth 1 --branch afs \
    https://github.com/alex-ht/mamba.git /tmp/mamba
cd /tmp/mamba
MAMBA_FORCE_BUILD=TRUE MAMBA_KEEP_CUDA_BUILD=TRUE MAX_JOBS="${MAMBA_MAX_JOBS}" \
  uv pip install --no-build-isolation --no-config .
cd / && rm -rf /tmp/mamba
SHELL

# vLLM and FA4 resolved together so their shared nvidia-cutlass-dsl pin is reconciled in
# one pass. FA4 is a pure-Python wheel (CuTe DSL, JIT at runtime), so nothing compiles here
# and FA2 is deliberately absent -- it is sdist-only and has no prebuilt wheel for torch 2.11.
# xformers is pinned because only 0.0.35 relaxed its exact torch pin.
RUN --mount=type=cache,target=/root/.cache/uv \
    UV_TORCH_BACKEND=$TORCH_BACKEND uv pip install --prerelease=allow \
        "vllm==${VLLM_VERSION}" \
        "flash-attn-4==${FLASH_ATTN_4_VERSION}" \
        "xformers==0.0.35"

# fix so that git fetch/pull from remote works with shallow clone
RUN git config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*" && \
    git config --get remote.origin.fetch && \
    git config --global credential.helper store

COPY .axolotl-complete.bash /root/.axolotl-complete.bash
RUN chmod +x /root/.axolotl-complete.bash && \
    chmod +x /workspace/axolotl/scripts/uv-entrypoint.sh && \
    echo 'source /root/.axolotl-complete.bash' >> ~/.bashrc

# Experiment tracking. wandb, tensorboard and trackio are already core deps; these
# are the two that are not. mlflow-skinny is the client half of the `mlflow` extra --
# it drops the tracking server and its data-science stack (Flask, sqlalchemy,
# alembic, gunicorn, pandas, pyarrow, scikit-learn, matplotlib), which a training
# container that logs to a remote server never uses. Swap in `mlflow` if you want to
# run `mlflow ui` inside this image.
ARG MLFLOW_VERSION="3.15.1"
ARG SWANLAB_VERSION="0.9.2"

# Optional plugin deps. densemixer is the alternative MoE routing path for 26B-A4B,
# orjson is used by the KD plugin, math-verify by the GRPO math rewards.
ARG DENSEMIXER_VERSION="1.0.1"
ARG ORJSON_VERSION="3.11.9"
ARG MATH_VERIFY_VERSION="0.9.0"

# Large checkpoints (Gemma-4 26B/31B, Nemotron-H, …). HF_HUB_ENABLE_HF_TRANSFER is
# deprecated on huggingface_hub 1.x -- Xet superseded hf_transfer. Matches
# Dockerfile-cloud-uv.
ENV HF_XET_HIGH_PERFORMANCE=1

# Opt out of axolotl's telemetry (telemetry/manager.py accepts "1" or "true").
ENV AXOLOTL_DO_NOT_TRACK=1

# Deliberately NOT installed:
#   llmcompressor - pins transformers<=5.10.1, which would downgrade the pinned
#                   5.14.1 and take native flash_attention_4 dispatch with it
#   hatchery      - the PyPI package of that name is an unrelated CD helper; the
#                   `hatchery.core.client` the plugin imports is not published
#   deep_gemm     - sdist only, provenance unverified (gates the FP8 MoE backward)
#   sf_layout     - not published on PyPI at all (gates part of the FP4 CuTe path)
# (`deep-ep` on PyPI is a name placeholder with no author, homepage or deps -- the
#  real library is built from source below.)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install \
        "mlflow-skinny==${MLFLOW_VERSION}" \
        "swanlab==${SWANLAB_VERSION}" \
        "densemixer==${DENSEMIXER_VERSION}" \
        "orjson==${ORJSON_VERSION}" \
        "math-verify==${MATH_VERIFY_VERSION}"

# DeepEP, for the expert_parallel plugin. Built from source. V2 switched from
# NVSHMEM to NCCL Gin, so no NVSHMEM dependency is needed for intranode builds.
# ARCH NOTE: sm_100 is untested upstream. setup.py asserts
# DISABLE_AGGRESSIVE_PTX_INSTRS==1 whenever TORCH_CUDA_ARCH_LIST is not exactly "9.0".
ARG DEEPEP_REF="fix/large-model-int-overflow"
ARG DEEPEP_TORCH_CUDA_ARCH_LIST="9.0;10.0"
ARG DEEPEP_MAX_JOBS="16"

# DeepEP V2 uses the NCCL Gin backend, which requires NCCL >= 2.30.4.
# torch 2.11 ships nvidia-nccl-cu13==2.28.9, so we upgrade before building.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install "nvidia-nccl-cu13>=2.30.4"

RUN --mount=type=cache,target=/root/.cache/uv <<'SHELL'
set -eux
git clone --depth 1 --branch "${DEEPEP_REF}" https://github.com/alex-ht/DeepEP.git /tmp/DeepEP
cd /tmp/DeepEP

TORCH_CUDA_ARCH_LIST="${DEEPEP_TORCH_CUDA_ARCH_LIST}" \
MAX_JOBS="${DEEPEP_MAX_JOBS}" \
  uv pip install --no-build-isolation .

cd / && rm -rf /tmp/DeepEP
SHELL

# Fail the build rather than a training run if any of the above moved the pinned
# HF/torch stack, and confirm Gemma-4 CCE patches plus mamba-ssm are
# wired up. find_spec only -- importing mamba_ssm/causal_conv1d loads CUDA
# extensions and would fail on a GPU-less builder.
RUN python -c "\
import importlib.metadata as md, importlib.util, torch; \
assert torch.__version__.startswith('2.11.'), 'torch moved: ' + torch.__version__; \
assert md.version('transformers') == '5.14.1', 'transformers moved: ' + md.version('transformers'); \
fa = [x.replace('_', '-') for x in md.packages_distributions().get('flash_attn', [])]; \
assert 'flash-attn-4' in fa, 'FA4 not registered: ' + repr(fa); \
assert 'flash-attn' not in fa, 'FA2 present, will shadow FA4: ' + repr(fa); \
from cut_cross_entropy.transformers.patch import AXOLOTL_CCE_FORK, PATCH_FNS; \
assert AXOLOTL_CCE_FORK, 'CCE is not the axolotl fork'; \
missing = [k for k in ('gemma4', 'gemma4_text', 'gemma4_unified', 'gemma4_unified_text') if k not in PATCH_FNS]; \
assert not missing, 'CCE lacks native gemma4 patches: ' + repr(missing); \
absent = [m for m in ('densemixer', 'mlflow', 'swanlab', 'orjson', 'math_verify', 'triton', 'bitsandbytes', 'mamba_ssm', 'causal_conv1d') if importlib.util.find_spec(m) is None]; \
assert not absent, 'missing modules: ' + repr(absent); \
assert md.version('mamba_ssm').startswith('2.3.2'), 'unexpected mamba-ssm: ' + md.version('mamba_ssm'); \
assert md.version('causal_conv1d').startswith('1.5.3'), 'unexpected causal-conv1d: ' + md.version('causal_conv1d'); \
assert md.version('deep_ep').startswith('2.1.0'), 'unexpected deep_ep: ' + md.version('deep_ep'); \
import deep_ep; \
assert deep_ep.Buffer is not None; \
print('ok: torch', torch.__version__, '| transformers', md.version('transformers'), '| deep_ep', md.version('deep_ep'), '| mamba-ssm', md.version('mamba_ssm'), '| flash_attn owned by', fa, '| CCE gemma4 patches present')"

ENTRYPOINT ["/workspace/axolotl/scripts/uv-entrypoint.sh"]
